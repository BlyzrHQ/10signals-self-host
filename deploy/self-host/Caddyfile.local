{
  admin off
  auto_https off
  persist_config off
}
:8080 {
  @badHost expression `{http.request.hostport} != "localhost:{$TEN_SIGNALS_PORT:8787}"`
  respond @badHost "Use http://localhost:{$TEN_SIGNALS_PORT:8787}" 403
  @badOrigin {
    header Origin *
    not header Origin http://localhost:{$TEN_SIGNALS_PORT:8787}
  }
  respond @badOrigin "Invalid origin" 403
  reverse_proxy web:3000
}
