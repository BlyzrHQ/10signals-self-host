# Separate candidate image; never uses the company VPS Compose file or downloads.
FROM node:22.18.0-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --include=optional && node --input-type=module -e "await import('rolldown')"
COPY . .
RUN test ! -e .env.self-host && test ! -d .local && test ! -e .git \
    && test -z "$(find . -path ./node_modules -prune -o \( -name '.env*' -o -name '*.sqlite*' -o -name '*.db' -o -name '.local' -o -name '.git' \) -print -quit)"
RUN npm run build:vps

FROM node:22.18.0-bookworm-slim
ENV NODE_ENV=production PORT=3000 MARKET_SIGNAL_DEPLOY_TARGET=node
WORKDIR /app
RUN groupadd --gid 10001 signals && useradd --uid 10001 --gid 10001 --no-create-home signals \
    && mkdir /data && chown 10001:10001 /data
# The local worker executes the existing TypeScript engine on Node 22.18.
# Candidate includes locked dependencies; slimming the runtime is a release gate.
COPY --from=build --chown=10001:10001 /app /app
USER 10001:10001
VOLUME ["/data"]
EXPOSE 3000
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=5 CMD ["node","-e","fetch('http://127.0.0.1:3000/').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"]
CMD ["node","node_modules/vinext/dist/cli.js","start","--host","0.0.0.0"]
